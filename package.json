{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "malmo-ff",
  "title": "Malmö FF",
  "description": "Malmö FF standings and schedule",
  "icon": "malmo-icon.png",
  "author": "linuslundahl",
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Summary",
      "subtitle": "Malmö FF standings and schedule",
      "description": "A summary of Malmö FF's current standings and upcoming games",
      "mode": "view"
    },
    {
      "name": "next-game",
      "title": "Malmö FF",
      "description": "A summary of Malmö FF's current standings and upcoming games",
      "mode": "no-view",
      "interval": "15m"
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.6.0",
    "@raycast/utils": "^2.3.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS"
  ]
}
